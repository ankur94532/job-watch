# Copy to deploy/jobswatch.env (gitignored) and fill in.
# `make install` renders these into the launchd plist's EnvironmentVariables.

# From @BotFather. Without both of these, alerts are printed to the log instead.
TELEGRAM_BOT_TOKEN=
# Your chat id: message the bot, then
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | grep -o '"chat":{"id":[0-9-]*'
TELEGRAM_CHAT_ID=

# Named in the User-Agent so an ATS admin can see who is polling them.
JOBSWATCH_CONTACT_URL=https://github.com/<you>/job-watch

# Defaults are fine; override to move the database or the logs.
#JOBSWATCH_DB=/Users/<you>/.local/share/jobswatch/jobs.db
#JOBSWATCH_LOGDIR=/Users/<you>/Library/Logs/jobswatch
